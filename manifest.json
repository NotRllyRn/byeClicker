{
    "name": "ByeClicker",
    "version": "4.1.0",
    "description": "ByeClicker is a browser extension that automatically answers iClicker questions for you.",
    "author": "Vaibhav Sharma",
    "homepage_url": "https://chromewebstore.google.com/detail/byeclicker/kmnlnlkcacgjkngggifcnalkldgpflic",
    "manifest_version": 3,
    "browser_specific_settings": {
        "gecko": {
            "id": "byeclicker@aszaw.github.io",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "websiteContent"
                ],
                "optional": [
                    "personallyIdentifyingInfo"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "action": {
        "default_title": "ByeClicker",
        "default_popup": "popup.html",
        "default_icon": "./assets/logo.png"
    },
    "icons": {
        "16": "./assets/logo-16.png",
        "32": "./assets/logo-32.png",
        "48": "./assets/logo-48.png",
        "128": "./assets/logo-128.png"
    },
    "permissions" : [
        "tabs",
        "storage"
    ],
    "host_permissions" : [
        "https://student.iclicker.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://student.iclicker.com/"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background" : {
        "scripts" : [
            "./background.js"
        ],
        "service_worker" : "./background.js"
    }
}
